# Copy to .env. All EXPO_PUBLIC_* values are embedded in the app, never server secrets.
# Android application identity; independent of the EAS Gradle profile.
APP_VARIANT=development

# Clerk — https://dashboard.clerk.com -> API Keys (Expo)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public MapTiler key for native maps. Never put the server geocoding key here.
EXPO_PUBLIC_MAPTILER_API_KEY=

# API base URL. Use your machine's LAN IP when testing on a physical device,
# e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: API Preview protection bypass, embedded in the app.
# Leave empty for local/Production APIs; only use a dedicated Preview bypass value.
EXPO_PUBLIC_VERCEL_PROTECTION_BYPASS=

# Optional: DSN of the Mobile Sentry project (distinct from the Web project).
EXPO_PUBLIC_SENTRY_DSN=

# Optional OTA channel; defaults to APP_VARIANT. Development PR builds use
# ci-pr-<number> or development-pr-<number>; Production accepts only production.
# EXPO_UPDATE_CHANNEL=development

# Optional EAS file-secret path used by Android FCM builds.
# For local builds, use a Google Play emulator image and rerun Expo prebuild after changing this path.
GOOGLE_SERVICES_JSON=
