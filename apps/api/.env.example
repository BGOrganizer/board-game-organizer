# Clerk — https://dashboard.clerk.com -> API Keys (Backend / secret key)
CLERK_SECRET_KEY=

# MongoDB connection string (local: mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=board-game-organizer

# Optional: comma-separated origins allowed to call the API in production
# (e.g. https://web.example.com,https://api.example.com). Empty = all origins in dev only.
ALLOWED_ORIGINS=
