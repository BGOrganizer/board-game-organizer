# Copy to .env.local. Use the same Clerk instance as the web and mobile apps.
# Clerk — https://dashboard.clerk.com -> API Keys (Backend / secret key)
CLERK_SECRET_KEY=
# Clerk publishable key — required by the /invite/<token> claim page (client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# MapTiler authenticated address verification (server only)
MAPTILER_GEOCODING_KEY=

# MongoDB connection string for compose.yaml (replica set required by transactions)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=board-game-organizer

# Optional Inngest event publishing; configure all three values together.
# /api/inngest currently registers no worker functions, so these do not enable autonomous closure.
# Authorized reads materialize closure after the exact cutoff; confirmation remains manual.
# Use separate Inngest environments for Production/Preview; CI database names remain isolated.
# See docs/organizations-events-operations.md. Never commit real keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_ENV=

# Comma-separated web origins for credentialed cross-origin requests outside local development
# (e.g. https://web.example.com). Local development and *.vercel.app have existing automatic handling.
ALLOWED_ORIGINS=
# BGG application token for collection linking/sync and game metadata enrichment (server only).
# Leave empty only when not using the BGG integration.
BGG_TOKEN=

# Clerk webhook signing secret (SVIX). Found in Clerk Dashboard →
# Webhooks → your endpoint → Signing secret (whsec_...). Required by
# POST /api/webhooks/clerk (user.created/updated/deleted mirroring).
CLERK_WEBHOOK_SECRET=
# Preview only: dev DB for verified Clerk webhooks when app DB is isolated for CI.
# Set to the normal Preview MONGODB_DB_NAME in Vercel; leave unset in production.
# CLERK_WEBHOOK_DB_NAME=board-game-organizer

# Optional remote push delivery. Inbox notifications work without these values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM private keys may contain escaped \n line breaks. Leave empty until push is configured.
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.bgo.mobile
APNS_PRODUCTION=false

