# Clerk — https://dashboard.clerk.com -> API Keys (Backend / secret key)
CLERK_SECRET_KEY=
# Clerk publishable key — required by the /invite/<token> claim page (client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...

# MongoDB connection string (local: mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=board-game-organizer

# Optional: comma-separated origins allowed to call the API in production
# (e.g. https://web.example.com,https://api.example.com). Empty = all origins in dev only.
ALLOWED_ORIGINS=

# Clerk webhook signing secret (SVIX). Found in Clerk Dashboard →
# Webhooks → your endpoint → Signing secret (whsec_...). Required by
# POST /api/webhooks/clerk (user.created/updated/deleted mirroring).
CLERK_WEBHOOK_SECRET=whsec_...

