meta {
  name: Search users
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/search?query={{searchQuery}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{actorToken}}
}

tests {
  test("returns matching users", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().users).to.be.an("array");
  });
}
