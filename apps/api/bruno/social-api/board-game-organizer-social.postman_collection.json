{
  "info": {
    "_postman_id": "82af04bc-1aee-4a92-9825-7da6f1bda16b",
    "name": "Board Game Organizer Social API",
    "description": "Run requests in sequence. Set two Clerk user IDs and fresh session JWTs in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "actorUserId", "value": "user_replace_actor" },
    { "key": "targetUserId", "value": "user_replace_target" },
    { "key": "actorToken", "value": "" },
    { "key": "targetToken", "value": "" },
    { "key": "searchQuery", "value": "target@example.com" }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "02 Search users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/users/search?query={{searchQuery}}"
      }
    },
    {
      "name": "03 Actor follows target",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/follows/{{targetUserId}}"
      }
    },
    {
      "name": "04 Actor lists following",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/follows?direction=following"
      }
    },
    {
      "name": "05 Target lists followers",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{targetToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/follows?direction=followers"
      }
    },
    {
      "name": "06 Actor unfollows target",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/follows/{{targetUserId}}"
      }
    },
    {
      "name": "07 Actor sends friend request",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests/{{targetUserId}}"
      }
    },
    {
      "name": "08 Target lists incoming requests",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{targetToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests?direction=incoming"
      }
    },
    {
      "name": "09 Target accepts actor request",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{targetToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"accept\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/friend-requests/{{actorUserId}}"
      }
    },
    {
      "name": "10 Actor lists friends",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friends"
      }
    },
    {
      "name": "11 Actor removes target friendship",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friends/{{targetUserId}}"
      }
    },
    {
      "name": "12 Actor sends another friend request",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests/{{targetUserId}}"
      }
    },
    {
      "name": "13 Target rejects actor request",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{targetToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"reject\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/friend-requests/{{actorUserId}}"
      }
    },
    {
      "name": "14 Actor resends after rejection",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests/{{targetUserId}}"
      }
    },
    {
      "name": "15 Actor lists outgoing requests",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests?direction=outgoing"
      }
    },
    {
      "name": "16 Actor cancels outgoing request",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/friend-requests/{{targetUserId}}"
      }
    },
    {
      "name": "17 Actor blocks target",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/blocks/{{targetUserId}}"
      }
    },
    {
      "name": "18 Actor lists blocked users",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/blocks"
      }
    },
    {
      "name": "19 Blocked target cannot follow actor",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{targetToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/follows/{{actorUserId}}"
      }
    },
    {
      "name": "20 Actor unblocks target",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{actorToken}}", "type": "text" }],
        "url": "{{baseUrl}}/api/blocks/{{targetUserId}}"
      }
    }
  ]
}
