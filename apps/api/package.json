    "backfill:users": "tsx scripts/backfill-users.ts"
  },
  "dependencies": {
    "@board-game-organizer/schemas": "workspace:*",
    "@board-game-organizer/shared": "workspace:*",
    "@clerk/nextjs": "^7.9.1",
    "mongodb": "^7.6.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svix": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@board-game-organizer/biome-config": "workspace:*",
    "@board-game-organizer/typescript-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
