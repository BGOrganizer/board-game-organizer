    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svix": "^1.99.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@board-game-organizer/biome-config": "workspace:*",
    "@board-game-organizer/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "testcontainers": "^10.13.0",
    "tsx": "^4.23.12",
