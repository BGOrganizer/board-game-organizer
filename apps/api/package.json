{
  "name": "api",
  "version": "1.10.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --port 4000",
    "build": "bun run --filter @board-game-organizer/mcp build && next build",
    "start": "next start -H 0.0.0.0 --port 4000",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "format": "biome format --write .",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "backfill:users": "tsx scripts/backfill-users.ts"
  },
  "dependencies": {
    "@board-game-organizer/mcp": "workspace:*",
    "@board-game-organizer/query": "workspace:*",
    "@board-game-organizer/schemas": "workspace:*",
    "@board-game-organizer/shared": "workspace:*",
    "@clerk/nextjs": "^7.9.1",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@xmldom/xmldom": "^0.9.12",
    "geo-tz": "8.1.10",
    "inngest": "4.21.1",
    "lucide-react": "^1.41.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.4",
    "openskill": "^5.0.1",
    "postcss": "^8.5.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.4",
    "svix": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@board-game-organizer/biome-config": "workspace:*",
    "@board-game-organizer/typescript-config": "workspace:*",
    "@next/env": "16.3.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "4.1.12",
    "next-test-api-route-handler": "5.0.7",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
