{
  "name": "api",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
