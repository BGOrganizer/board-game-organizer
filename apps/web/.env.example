# Copy to .env.local. Use the same Clerk instance as the API and mobile app.
# Clerk — https://dashboard.clerk.com -> API Keys (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only key required by Clerk middleware; never use NEXT_PUBLIC_ for it.
CLERK_SECRET_KEY=

# Public MapTiler key for web maps. Never put the server geocoding key here.
NEXT_PUBLIC_MAPTILER_API_KEY=

# API base URL used by the web app (defaults to http://localhost:4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: API Preview protection bypass, embedded in the client bundle.
# Leave empty for local/Production APIs; only use a dedicated Preview bypass value.
NEXT_PUBLIC_VERCEL_PROTECTION_BYPASS=

# Optional Firebase Web Push configuration. Inbox works without it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
