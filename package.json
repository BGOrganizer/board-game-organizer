{
  "name": "board-game-organizer",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "release": "semantic-release",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@board-game-organizer/biome-config": "workspace:*",
    "@board-game-organizer/typescript-config": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lingui/cli": "^6.6.0",
    "@lingui/conf": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "semantic-release": "^25.0.9",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "jsonc-parser": "3.3.1"
  },
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "utf-8-validate": "5.0.10"
  },
  "patchedDependencies": {
    "heroui-native@1.0.9": "patches/heroui-native@1.0.9.patch",
    "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch"
  },
  "trustedDependencies": [
    "@firebase/util",
    "@sentry/cli",
    "browser-tabs-lock",
    "bufferutil",
    "core-js",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "utf-8-validate"
  ]
}
